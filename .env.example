# Diamond Connect - Example environment variables

# PostgreSQL connection string (required for API)
DATABASE_URL=postgres://user:password@localhost:5432/diamond_db

# JWT secret used to sign tokens (set a strong value in production)
JWT_SECRET=replace_with_a_long_random_secret

# API ports
PORT=5001
AI_SERVICE_PORT=5002

# Frontend base URL for dev (Vite)
VITE_API_URL=http://localhost:5001

# Comma-separated allowed origins for CORS. Use '*' for development only.
ALLOWED_ORIGINS=http://localhost:5173

# Admin seed credentials (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Rate limiter (optional)
RATE_WINDOW_MS=900000
RATE_MAX=300
# Strict face detection - set to true to reject uploads when server-side detection is unavailable
FACE_DETECTION_STRICT=false

